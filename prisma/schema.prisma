enum DocumentType {
  DNI
  PASAPORTE
  CARNET_EXTRANJERIA
}
enum StatusUser {
  ONLINE
  DISABLED
  RESTORE
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  @@map("categories")
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([categoryId])
  @@map("sub_categories")
}

model User {
  id        Int      @id @default(autoincrement())
  documentType   DocumentType
  documentNumber String   @unique
  lastName  String
  firstName String
  email     String   @unique
  password  String
  address   String?
  phone     String?
  dateOfBirth DateTime?
  status    StatusUser @default(RESTORE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}