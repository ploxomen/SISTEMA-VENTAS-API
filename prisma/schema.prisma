enum DocumentType {
  DNI
  PASAPORTE
  CARNET_EXTRANJERIA
}
enum StatusUser {
  ONLINE
  DISABLED
  RESTORE
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  @@map("categories")
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([categoryId])
  @@map("sub_categories")
}

model User {
  id        Int      @id @default(autoincrement())
  documentType   DocumentType
  documentNumber String   @unique
  lastName  String
  firstName String
  email     String   @unique
  password  String
  address   String?
  phone     String?
  dateOfBirth DateTime?
  status    StatusUser @default(RESTORE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRoles   UserRole[]
  @@map("users")
}

model Role {
  id    Int     @id @default(autoincrement())
  name String
  icon String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRoles   UserRole[]
  moduleRol ModuleRol[]
  @@map("roles")
}
model UserRole {
  userId  Int
  roleId  Int
  isActive Boolean @default(false)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([userId, roleId])
  @@map("user_roles")
}

model Brand {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("brand")
}

model ModuleGroup {
  id Int  @id @default(autoincrement())
  name String
  description String?
  icon String
  modules Module[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@map("module_group")
}

model Module {
  id Int  @id @default(autoincrement())
  name String
  description String?
  icon String
  url String
  moduleGroupId Int?
  moduleGroup   ModuleGroup? @relation(fields: [moduleGroupId], references: [id], onDelete: Cascade)
  moduleRol ModuleRol[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@map("module")
}

model ModuleRol {
  id Int @id @default(autoincrement())
  moduleId Int
  rolId Int
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rol Role @relation(fields: [rolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("module_rol")
}
