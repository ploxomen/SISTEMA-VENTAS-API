enum DocumentType {
  DNI
  PASAPORTE
  CARNET_EXTRANJERIA
}
enum StatusGlobal {
  DISABLED
  ENABLED
}
enum TypeSupplier {
  EMPRESA
  PERSONA_NATURAL
}
enum StatusUser {
  ONLINE
  DISABLED
  RESTORE
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]
  products Product[]
  @@map("categories")
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  products Product[]
  @@index([categoryId])
  @@map("sub_categories")
}

model User {
  id        Int      @id @default(autoincrement())
  documentType   DocumentType
  documentNumber String   @unique
  lastName  String
  firstName String
  email     String   @unique
  password  String
  address   String?
  phone     String?
  dateOfBirth DateTime?
  status    StatusUser @default(RESTORE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRoles   UserRole[]
  refreshTokens RefreshToken[]
  @@map("users")
}

model Role {
  id    Int     @id @default(autoincrement())
  name String
  icon String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRoles   UserRole[]
  moduleRol ModuleRol[]
  @@map("roles")
}
model UserRole {
  userId  Int
  roleId  Int
  isActive Boolean @default(false)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([userId, roleId])
  @@map("user_roles")
}

model Brand {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
  @@map("brand")
}

model ModuleGroup {
  id Int  @id @default(autoincrement())
  name String
  description String?
  icon String
  modules Module[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@map("module_group")
}

model Module {
  id Int  @id @default(autoincrement())
  name String
  description String?
  icon String
  url String
  moduleGroupId Int?
  moduleGroup   ModuleGroup? @relation(fields: [moduleGroupId], references: [id], onDelete: Cascade)
  moduleRol ModuleRol[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@map("module")
}

model ModuleRol {
  id Int @id @default(autoincrement())
  moduleId Int
  rolId Int
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rol Role @relation(fields: [rolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("module_rol")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([userId])
}

model Product {
  id  Int @id @default(autoincrement())
  name String
  description String?
  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])
  subcategoryId Int
  subcategory SubCategory @relation(fields: [subcategoryId], references: [id])
  brandId Int
  brand Brand @relation(fields: [brandId], references: [id])
  model String?
  initialStock Int
  minimunStock Int
  purchasePrice Decimal @db.Decimal(10, 2)
  salePrice Decimal @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)
  hasExpiration Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productLote ProductLote[]
  productImg ProductImg[]
  @@map("product")
}
model ProductImg {
  id  Int @id @default(autoincrement())
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url String
  name String
  isPrincipal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("product_img")
}
model ProductLote {
  id  Int @id @default(autoincrement())
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber String
  quantity Int
  expirationDate DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("product_lote")
}

model Supplier {
  id  Int @id @default(autoincrement())
  type TypeSupplier @default(EMPRESA)
  fullName String
  numberDocument String?
  email String?
  phone String?
  cellphone String 
  status StatusGlobal @default(ENABLED)
}